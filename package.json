{
  "name": "arc3dlab",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "main": "dist/arc3dlab.esm.js",
  "module": "dist/arc3dlab.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/arc3dlab.esm.js"
    },
    "./engine-cesium": {
      "types": "./dist/engine-cesium.d.ts",
      "import": "./dist/engine-cesium.js"
    }
  },
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs": "node scripts/generate-docs.js",
    "docs:watch": "typedoc --options typedoc.json --watch",
    "docs:build": "typedoc --options typedoc.json",
    "dev": "node scripts/dev-setup.js",
    "dev:watch": "node scripts/dev-setup.js --watch"
  },
  "keywords": [
    "3D",
    "webGL",
    "WebGis",
    "Cesium",
    "Arc3DLab",
    "Arc3DLab SDK"
  ],
  "author": "arc3dlab",
  "license": "GPL-2.0-only",
  "meta": {
    "nodejsVersion": "v22.20.0"
  },
  "description": "A Modular 3D WebGIS Runtime built on CesiumJS",
  "peerDependencies": {
    "cesium": ">=1.136.0 <1.147.0"
  },
  "devDependencies": {
    "typedoc": "^0.28.15",
    "typedoc-material-theme": "^1.4.1",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "cesium": "1.136.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/*",
    "README.md",
    "CHANGES.md",
    "LOG.md",
    "NOTICE.md",
    "LICENSE"
  ]
}
