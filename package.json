{
  "name": "arc3dlab",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "main": "dist/arc3dlab.esm.js",
  "module": "dist/arc3dlab.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/arc3dlab.esm.js"
    },
    "./engine-cesium": {
      "types": "./dist/engine-cesium.d.ts",
      "import": "./dist/engine-cesium.js"
    }
  },
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:pack": "node scripts/pack-smoke.mjs",
    "bench": "node scripts/benchmark.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"packages/**/*.ts\" \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.{js,mjs}\" \"playwright.config.ts\" \".github/**/*.yml\" \"package.json\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.{js,mjs}\" \"playwright.config.ts\" \".github/**/*.yml\" \"package.json\"",
    "lint:deps": "node scripts/release-gate.mjs deps",
    "lint:exports": "node scripts/release-gate.mjs exports",
    "lint:license": "node scripts/release-gate.mjs license",
    "lint:api": "node scripts/release-gate.mjs api",
    "lint:size": "node scripts/check-bundle-size.mjs",
    "lint:audit": "npm audit --omit=dev --audit-level=high",
    "lint:docs": "node scripts/api-docs/check.mjs",
    "gate": "npm run typecheck && npm test && npm run lint:deps && npm run lint:exports && npm run lint:license && npm run lint:api && npm run lint:docs && npm run format:check",
    "docs:extract": "node scripts/api-docs/extract.mjs",
    "docs": "node scripts/api-docs/build.mjs",
    "docs:build": "node scripts/api-docs/build.mjs",
    "docs:preview": "python3 -m http.server 5174 --bind 0.0.0.0 --directory api-docs/api",
    "guide:dev": "vitepress dev guide --port 5175 --host 0.0.0.0",
    "guide:build": "vitepress build guide",
    "guide:preview": "vitepress preview guide --port 5175 --host 0.0.0.0",
    "dev": "npm run build"
  },
  "keywords": [
    "3D",
    "webGL",
    "WebGis",
    "Cesium",
    "Arc3DLab",
    "Arc3DLab SDK"
  ],
  "author": "arc3dlab",
  "license": "GPL-2.0-only",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "meta": {
    "nodejsVersion": "v22.20.0"
  },
  "description": "A Modular 3D WebGIS Runtime built on CesiumJS",
  "peerDependencies": {
    "cesium": "1.146.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitest/coverage-v8": "^3.2.4",
    "cesium": "1.146.0",
    "prettier": "^3.9.9",
    "typedoc": "^0.28.15",
    "typescript": "^5.6.3",
    "vite": "^7.1.7",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/*",
    "README.md",
    "CHANGES.md",
    "LOG.md",
    "NOTICE.md",
    "LICENSE"
  ]
}
